# --- CLI --------------------------------------------------------------------

def cli(args):
    cmd = args[0] if args else "status"
    if cmd == "status":
        s = status()
        e = s["exit"]
        print(f"routing:     {'on' if s['routing'] else 'off'}")
        print(f"forwarding:  {'on' if s['forwarding'] else 'OFF'}")
        print(f"mihomo:      {s['mihomo']}")
        print(f"kill switch: {'on' if s['kill_switch'] else 'OFF'}")
        print(f"tun route:   {'up' if s['tun_route'] else 'down (blackholed)'}")
        print(f"selected:    {s['selected'] or '?'}")
        print(f"exit IP:     {e['ip']}  {e.get('city')}, {e.get('country')}  {e.get('org')}" if e
              else "exit IP:     unreachable (no proxy selected, or proxy down)")
    elif cmd == "list":
        v = proxies_view()
        if not v["proxies"]:
            print("no proxies yet: proxyctl add NAME socks5://user:pass@host:port")
        for p in v["proxies"]:
            print(f"{'*' if p['name'] == v['now'] else ' '} {p['name']:<20} {p['type']} {p['server']}:{p['port']}")
        if v["now"] == "REJECT":
            print("* REJECT (everything blocked)")
    elif cmd == "add" and len(args) == 3:
        add_proxy(args[1], args[2])
        print(f"added {args[1]}, selected: {selected()}")
    elif cmd == "remove" and len(args) == 2:
        remove_proxy(args[1])
        print(f"removed {args[1]}, selected: {selected()}")
    elif cmd == "use" and len(args) == 2:
        use_proxy(args[1])
        print(f"switched to {args[1]}")
    elif cmd == "test":
        for name, ms in test_all().items():
            print(f"{name:<20} {f'{ms} ms' if ms else 'timeout'}")
    elif cmd == "routing" and len(args) == 1:
        print(f"routing: {'on' if load_state()['routing'] else 'off'}")
    elif cmd == "routing" and args[1] == "on":
        routing_on(force="--force" in args)
        print("routing on: this VPS is advertised as an exit node")
        print("first time? Tailscale admin console -> Machines -> this VPS -> Edit route settings -> Use as exit node")
    elif cmd == "routing" and args[1] == "off":
        routing_off()
        print("routing off: exit node no longer advertised, VPS DNS restored")
    elif cmd == "forwarding":
        for key, val in fwd_values().items():
            print(f"{key} = {val}")
        if fwd_on():
            print("forwarding is on")
        else:
            enable_forwarding()
            print(f"forwarding enabled (saved in {SYSCTL_FILE})")
    elif cmd == "secret":
        print(load_state()["secret"] or "no secret yet: proxyctl init")
    elif cmd == "init":
        init()
    elif cmd == "serve":
        ThreadingHTTPServer(("0.0.0.0", PANEL_PORT), Panel).serve_forever()
    else:
        print(__doc__.strip())
        return 1
    return 0


if __name__ == "__main__":
    if os.geteuid() != 0:
        sys.exit("run as root: sudo proxyctl " + " ".join(sys.argv[1:]))
    try:
        sys.exit(cli(sys.argv[1:]))
    except Err as e:
        sys.exit(f"error: {e}")
    except urllib.error.URLError as e:
        sys.exit(f"error: mihomo API unreachable ({e.reason}): systemctl status mihomo")

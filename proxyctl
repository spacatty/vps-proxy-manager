class Err(Exception):
    pass


def run(cmd, check=True):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        if check:
            raise Err(f"{cmd[0]} is not installed")
        return ""
    if check and r.returncode != 0:
        raise Err(f"{' '.join(cmd)} failed: {(r.stderr or r.stdout).strip()}")
    return r.stdout


def ok(cmd):
    try:
        return subprocess.run(cmd, capture_output=True).returncode == 0
    except FileNotFoundError:
        return False


# --- state.json: the source of truth --------------------------------------

def load_state():
    try:
        with open(STATE) as f:
            st = json.load(f)
    except FileNotFoundError:
        st = {}
    if "routing" in st:  # older versions had a single routing flag
        st.setdefault("exit_node", st.pop("routing"))
    st.setdefault("secret", "")
    st.setdefault("proxies", [])
    st.setdefault("egress", "proxy")
    for key, default in FEATURES.items():
        st.setdefault(key, default)
    st.setdefault("ports", [dict(p) for p in DEFAULT_PORTS])
    st.setdefault("cliproxyapi_keys", {})
    return st


def write_private(path, text):
    tmp = path + ".tmp"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        f.write(text)
    os.replace(tmp, path)


def save_state(st):
    write_private(STATE, json.dumps(st, indent=2) + "\n")


def render(st):
    """config.yaml = base.yaml + generated keys (JSON is valid YAML)."""
    with open(BASE) as f:
        base = f.read()
    group = {"name": GROUP, "type": "select",
             "proxies": [p["name"] for p in st["proxies"]] + ["REJECT"]}
    out = base.rstrip() + "\n\n# --- generated by proxyctl from state.json, edits here are overwritten ---\n"
    out += f"secret: {json.dumps(st['secret'])}\n"
    out += f"proxies: {json.dumps(st['proxies'])}\n"
    out += f"proxy-groups: {json.dumps([group])}\n"
    write_private(CONF, out)


def init():
    st = load_state()
    if not st["secret"]:
        st["secret"] = secrets.token_urlsafe(24)
        print("generated a new panel secret")
    save_state(st)
    render(st)


def restart_mihomo(st):
    """Save, rebuild config.yaml and restart mihomo (ExecStartPost re-adds the tun0 route)."""
    save_state(st)
    render(st)
    run(["systemctl", "restart", "mihomo"])
    for _ in range(30):
        try:
            api("GET", "/version", timeout=2)
            return
        except Exception:
            time.sleep(0.5)
    raise Err("mihomo did not come back after restart: journalctl -u mihomo -n 50")


# --- mihomo API -------------------------------------------------------------

def api(method, path, body=None, timeout=10):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(API + path, data=data, method=method, headers={
        "Authorization": f"Bearer {load_state()['secret']}", "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        raw = r.read()
    return json.loads(raw) if raw else None


def selected():
    try:
        return api("GET", f"/proxies/{GROUP}")["now"]
    except Exception:
        return None


def ipinfo(via_proxy, timeout=15):
    # residential proxies can take several seconds on a fresh connection
    proxies = {"http": MIXED, "https": MIXED} if via_proxy else {}
    opener = urllib.request.build_opener(urllib.request.ProxyHandler(proxies))
    try:
        with opener.open("https://ipinfo.io/json", timeout=timeout) as r:
            d = json.load(r)
        return {k: d.get(k) for k in ("ip", "city", "country", "org")}
    except Exception:
        return None


def exit_ips():
    with ThreadPoolExecutor(max_workers=2) as ex:
        proxy, direct = ex.map(ipinfo, (True, False))
    return {"proxy": proxy, "direct": direct}


def delay(name):
    """(ms, None) on success, (None, mihomo's error message) on failure."""
    # plain HTTP: one round trip less than HTTPS, so slow proxies don't time out on the TLS handshake
    q = urllib.parse.urlencode({"url": "http://www.gstatic.com/generate_204", "timeout": 10000})
    try:
        return api("GET", f"/proxies/{urllib.parse.quote(name, safe='')}/delay?{q}", timeout=15).get("delay"), None
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read()).get("message")
        except Exception:
            msg = None
        return None, msg or f"HTTP {e.code}"
    except Exception as e:
        return None, str(getattr(e, "reason", e))


# --- proxies ----------------------------------------------------------------

def parse_proxy(name, spec):
    name, spec = name.strip(), spec.strip()
    if not NAME_RE.match(name) or name.upper() in RESERVED:
        raise Err("name: letters, digits, . _ - only (max 40), and not DIRECT/REJECT/PROXY")
    if "://" not in spec:
        # host:port or host:port:user:pass, the format most proxy sellers hand out
        parts = spec.split(":")
        if len(parts) not in (2, 4):
            raise Err("proxy must look like socks5://user:pass@host:port or host:port:user:pass")
        auth = f"{urllib.parse.quote(parts[2], safe='')}:{urllib.parse.quote(parts[3], safe='')}@" if len(parts) == 4 else ""
        spec = f"socks5://{auth}{parts[0]}:{parts[1]}"
    u = urllib.parse.urlsplit(spec)
    kind = {"socks5": "socks5", "socks5h": "socks5", "socks": "socks5", "http": "http", "https": "http"}.get(u.scheme)
    try:
        port = u.port
    except ValueError:
        port = None
    if not kind or not u.hostname or not port:
        raise Err("proxy must look like socks5://user:pass@host:port or host:port:user:pass")
    p = {"name": name, "type": kind, "server": u.hostname, "port": port}
    if u.username:
        p["username"] = urllib.parse.unquote(u.username)
        p["password"] = urllib.parse.unquote(u.password or "")
    if kind == "socks5":
        p["udp"] = True  # harmless if the provider has no UDP; UDP just fails, never leaks
    if u.scheme == "https":
        p["tls"] = True
    return p


def add_proxy(name, spec):
    with LOCK:
        st = load_state()
        p = parse_proxy(name, spec)
        if any(x["name"] == p["name"] for x in st["proxies"]):
            raise Err(f"{p['name']} already exists")
        st["proxies"].append(p)
        restart_mihomo(st)


def remove_proxy(name):
    with LOCK:
        st = load_state()
        left = [p for p in st["proxies"] if p["name"] != name]
        if len(left) == len(st["proxies"]):
            raise Err(f"no proxy named {name}")
        st["proxies"] = left
        LAST_TEST.pop(name, None)
        LAST_SPEED.pop(name, None)
        restart_mihomo(st)


def use_proxy(name):
    names = [p["name"] for p in load_state()["proxies"]] + ["REJECT"]
    if name not in names:
        raise Err(f"no proxy named {name}")
    api("PUT", f"/proxies/{GROUP}", {"name": name})
    try:  # existing connections keep the old IP; close them so everything moves over
        api("DELETE", "/connections")
    except Exception:
        pass


def test_all():
    names = [p["name"] for p in load_state()["proxies"]]
    with ThreadPoolExecutor(max_workers=8) as ex:
        results = {n: {"ms": ms, "error": err, "at": int(time.time())}
                   for n, (ms, err) in zip(names, ex.map(delay, names))}
    LAST_TEST.clear()
    LAST_TEST.update(results)
    return results


def curl_quote(s):
    return '"' + str(s).replace("\\", "\\\\").replace('"', '\\"') + '"'


def curl_transfer(proxy, opts):
    """One timed curl transfer. Returns curl's -w numbers, or raises Err.
    Options go in on stdin (-K -) so the proxy password never shows up in ps."""
    conf = list(opts) + ['write-out = "%{size_download} %{size_upload} %{time_pretransfer} %{time_starttransfer} %{time_total}"',
                         "silent", "show-error", "output = /dev/null", f"max-time = {SPEED_SECONDS}"]
    if proxy:
        scheme = {"socks5": "socks5h", "http": "https" if proxy.get("tls") else "http"}[proxy["type"]]
        conf.append("proxy = " + curl_quote(f"{scheme}://{proxy['server']}:{proxy['port']}"))
        if "username" in proxy:
            conf.append(f"proxy-user = {curl_quote(proxy['username'] + ':' + proxy['password'])}")
    try:
        r = subprocess.run(["curl", "-K", "-"], input="\n".join(conf) + "\n", capture_output=True, text=True,
                           timeout=SPEED_SECONDS + 15)
    except FileNotFoundError:
        raise Err("curl is not installed")
    except subprocess.TimeoutExpired:
        raise Err("curl hung")
    nums = r.stdout.split()
    # exit 28 = hit max-time, which is fine: the bytes moved so far still give the speed
    if r.returncode not in (0, 28) or len(nums) != 5:
        raise Err((r.stderr.strip().splitlines() or [f"curl exit {r.returncode}"])[-1].removeprefix("curl: "))
    return [float(n) for n in nums]


def speed_test(name):
    """Download and upload speed through one proxy (or DIRECT from the VPS), bypassing mihomo."""
    if name.upper() == "DIRECT":
        name, proxy = "DIRECT", None
    else:
        proxy = next((p for p in load_state()["proxies"] if p["name"] == name), None)
        if not proxy:
            raise Err(f"no proxy named {name}")
    if not SPEED_LOCK.acquire(blocking=False):
        raise Err("a speed test is already running, wait for it to finish")
    try:
        res = {"at": int(time.time())}
        try:
            down, _, _, first, total = curl_transfer(proxy, [f'url = "{SPEED_URL}/__down?bytes={SPEED_DOWN_BYTES}"'])
            if not down:
                raise Err("no data came back")
            # time from the first byte, so the proxy's connection setup doesn't count against its bandwidth
            res["down_mbps"] = round(down * 8 / 1e6 / max(total - first, 0.001), 2)
            res["ttfb_ms"] = round(first * 1000)
            with open(SPEED_UP_FILE, "wb") as f:
                f.write(bytes(SPEED_UP_BYTES))
            _, up, pre, _, total = curl_transfer(proxy, [f'url = "{SPEED_URL}/__up"', f'upload-file = "{SPEED_UP_FILE}"',
                                                         'request = "POST"'])
            res["up_mbps"] = round(up * 8 / 1e6 / max(total - pre, 0.001), 2) if up else None
        except Err as e:
            res["error"] = str(e)
        finally:
            if os.path.exists(SPEED_UP_FILE):
                os.remove(SPEED_UP_FILE)
        LAST_SPEED[name] = res
        return res
    finally:
        SPEED_LOCK.release()


# --- forwarding and DNS -----------------------------------------------------

def fwd_values():
    out = {}
    for key, path in FWD.items():
        try:
            with open(path) as f:
                out[key] = f.read().strip()
        except OSError:
            out[key] = "?"
    return out


def fwd_on():
    return all(v == "1" for v in fwd_values().values())


def enable_forwarding():
    """Turn on IPv4+IPv6 forwarding now and in sysctl.d, so it survives reboots."""
    try:
        with open(SYSCTL_FILE) as f:
            have = f.read().splitlines()
    except FileNotFoundError:
        have = []
    missing = [f"{k}=1" for k in FWD if f"{k}=1" not in have]
    if missing:
        with open(SYSCTL_FILE, "a") as f:
            f.write("".join(line + "\n" for line in missing))
    for path in FWD.values():
        with open(path, "w") as f:
            f.write("1\n")


def dns_to_mihomo():
    # Exit-node clients resolve through the VPS's resolver: send that through the proxy too.
    if not os.path.lexists(RESOLV_BACKUP):
        os.rename(RESOLV, RESOLV_BACKUP)  # keeps a systemd-resolved symlink as a symlink
    elif os.path.lexists(RESOLV):
        os.remove(RESOLV)
    with open(RESOLV, "w") as f:
        f.write("nameserver 127.0.0.1\noptions edns0\n")


def dns_restore():
    if os.path.lexists(RESOLV_BACKUP):
        if os.path.lexists(RESOLV):
            os.remove(RESOLV)
        os.rename(RESOLV_BACKUP, RESOLV)


def dns_via_mihomo():
    return os.path.lexists(RESOLV_BACKUP)


# --- firewall and exit-node routing -----------------------------------------

def wan_if():
    out = run(["ip", "-4", "route", "show", "default"], check=False).split()
    return out[out.index("dev") + 1] if "dev" in out else None


def own_chain(ipt, table, chain, parent):
    """Create/flush our chain and make sure the parent jumps to it first."""
    ok([ipt, "-t", table, "-N", chain])
    run([ipt, "-t", table, "-F", chain])
    if not ok([ipt, "-t", table, "-C", parent, "-j", chain]):
        run([ipt, "-t", table, "-I", parent, "1", "-j", chain])


def apply_firewall(st, warns):
    # In mangle INPUT, so it runs before Tailscale's, Docker's or ufw's filter rules can accept the packet.
    for ipt in ("iptables", "ip6tables"):
        try:
            own_chain(ipt, "mangle", "PM-INPUT", "INPUT")
            if not st["firewall"]:
                continue
            run([ipt, "-t", "mangle", "-A", "PM-INPUT", "-i", "lo", "-j", "RETURN"])
            for p in st["ports"]:
                rule = [ipt, "-t", "mangle", "-A", "PM-INPUT", "-p", p["proto"], "--dport", str(p["port"])]
                if p["access"] == "tailscale":
                    run(rule + ["!", "-i", "tailscale0", "-j", "DROP"])
                elif p["access"] == "closed":
                    run(rule + ["-j", "DROP"])
        except Err as e:
            if ipt == "iptables":
                raise
            warns.append(f"IPv6 firewall rules not applied: {e}")


def apply_exit_routing(st, warns):
    proxied = st["exit_node"] and st["egress"] == "proxy"
    while ok(["ip", "rule", "del", "priority", "100"]):
        pass
    for ipt in ("iptables", "ip6tables"):
        try:
            own_chain(ipt, "mangle", "PM-FWD", "FORWARD")
        except Err as e:
            if ipt == "iptables":
                raise
            warns.append(f"IPv6 forwarding rules not applied: {e}")
    if proxied:
        # Everything arriving from Tailscale goes to table 100: tun0 (mihomo), and with the kill switch a blackhole behind it.
        run(["ip", "rule", "add", "iif", "tailscale0", "lookup", "100", "priority", "100"])
        run(["ip", "route", "replace", "throw", "100.64.0.0/10", "table", "100"])
        # mihomo has no IPv6 out: drop it rather than let it leave directly
        ok(["ip6tables", "-t", "mangle", "-A", "PM-FWD", "-i", "tailscale0", "-j", "DROP"])
        if st["kill_switch"]:
            run(["ip", "route", "replace", "blackhole", "default", "table", "100", "metric", "500"])
            wan = wan_if()
            if wan:
                run(["iptables", "-t", "mangle", "-A", "PM-FWD", "-i", "tailscale0", "-o", wan, "-j", "DROP"])
            else:
                warns.append("could not detect the WAN interface; only the blackhole route guards the kill switch")
        else:
            ok(["ip", "route", "del", "blackhole", "default", "table", "100", "metric", "500"])
    if st["exit_node"] and ok(["iptables", "-n", "-L", "DOCKER-USER"]):
        # Docker sets the FORWARD policy to DROP, which stalls exit-node traffic
        for d in ("-i", "-o"):
            if not ok(["iptables", "-C", "DOCKER-USER", d, "tailscale0", "-j", "ACCEPT"]):
                run(["iptables", "-I", "DOCKER-USER", "1", d, "tailscale0", "-j", "ACCEPT"])


# --- CLIProxyAPI ------------------------------------------------------------

def _cpa_proxy_line(lines):
    """(index of `requests:`, index of its proxy-url line, child indent)."""
    for i, line in enumerate(lines):
        if re.match(r"^requests\s*:\s*(#.*)?$", line):
            indent = None
            for j in range(i + 1, len(lines)):
                s = lines[j]
                if not s.strip() or s.lstrip().startswith("#"):
                    continue
                if not s[0].isspace():
                    break
                ind = len(s) - len(s.lstrip())
                indent = indent if indent is not None else ind
                if ind == indent and re.match(r"\s*proxy-url\s*:", s):
                    return i, j, indent
            return i, None, indent or 2
    return None, None, 2


def cpa_get_proxy_url(text):
    lines = text.splitlines()
    _, j, _ = _cpa_proxy_line(lines)
    if j is None:
        return ""
    return lines[j].split(":", 1)[1].split(" #", 1)[0].strip().strip("\"'")


def cpa_set_proxy_url(text, url):
    lines = text.splitlines()
    i, j, indent = _cpa_proxy_line(lines)
    line = " " * indent + f"proxy-url: {json.dumps(url)}"
    if j is not None:
        lines[j] = line
    elif i is not None:
        lines.insert(i + 1, line)
    else:
        lines += ["", "requests:", f"  proxy-url: {json.dumps(url)}"]
    return "\n".join(lines) + "\n"


def cpa_container():
    return run(["docker", "inspect", "-f", "{{.State.Status}}", CPA_CONTAINER], check=False).strip() or None


def cpa_wanted_url(st):
    return MIXED if st["egress"] == "proxy" else ""


def apply_cliproxyapi(st, warns):
    if not st["cliproxyapi"]:
        return
    if not os.path.exists(CPA_CONF):
        warns.append(f"CLIProxyAPI is not installed ({CPA_CONF} missing)")
        return
    with open(CPA_CONF) as f:
        text = f.read()
    new = cpa_set_proxy_url(text, cpa_wanted_url(st))
    if new == text:
        return
    with open(CPA_CONF, "w") as f:
        f.write(new)
    if cpa_container() == "running" and not ok(["docker", "restart", CPA_CONTAINER]):
        warns.append("CLIProxyAPI config updated, but restarting its container failed")


def init_cliproxyapi():
    """Create CLIProxyAPI's config.yaml with generated keys (only if missing) and the host-network override."""
    st = load_state()
    if not os.path.exists(CPA_CONF):
        shutil.copy(f"{CPA_DIR}/config.example.yaml", CPA_CONF)
        keys = {"management": secrets.token_urlsafe(24), "api": "sk-" + secrets.token_urlsafe(32)}
        with open(CPA_CONF) as f:
            text = f.read()
        text = re.sub(r"(?m)^(\s+allow-remote:)\s*false\b", r"\1 true", text, count=1)
        text = re.sub(r'(?m)^(\s+secret-key:)\s*""', lambda m: f"{m.group(1)} {json.dumps(keys['management'])}", text, count=1)
        text = re.sub(r"(?m)^(\s+api-keys:[^\n]*\n)((\s+)- [^\n]*\n)+",
                      lambda m: f"{m.group(1)}{m.group(3)}- {json.dumps(keys['api'])}\n", text, count=1)
        with open(CPA_CONF, "w") as f:
            f.write(text)
        st["cliproxyapi_keys"] = keys
        save_state(st)
        print("CLIProxyAPI config created with new management and API keys")
    override = f"{CPA_DIR}/docker-compose.override.yml"
    if not os.path.exists(override):
        # Host networking: its ports fall under the panel's firewall rules (Docker's published
        # ports would bypass them), and it can reach mihomo on 127.0.0.1:7890.
        with open(override, "w") as f:
            f.write("services:\n  cli-proxy-api:\n    network_mode: host\n    ports: !reset []\n")


# --- DERP relay (setup.sh --derp) -------------------------------------------

def derp_info():
    """derper's state and the derpMap block for the tailnet policy file (None until its cert exists)."""
    if not os.path.exists(DERP_UNIT):
        return {"installed": False}
    info = {"installed": True, "service": run(["systemctl", "is-active", "derper"], check=False).strip() or "unknown",
            "host": None, "acl": None}
    try:
        certs = sorted(f for f in os.listdir(DERP_DIR) if f.endswith(".crt"))
    except FileNotFoundError:
        certs = []
    if not certs:
        return info
    with open(os.path.join(DERP_DIR, certs[0])) as f:
        pem = f.read()
    der = base64.b64decode("".join(l for l in pem.split("-----END")[0].splitlines() if l and not l.startswith("-----")))
    host = certs[0][:-len(".crt")]
    # self-signed for an IP: clients trust it because CertName pins its hash
    node = {"Name": f"{DERP_REGION}a", "RegionID": DERP_REGION, "HostName": host, "DERPPort": DERP_PORT,
            "CertName": "sha256-raw:" + hashlib.sha256(der).hexdigest()}
    if re.match(r"^\d+\.\d+\.\d+\.\d+$", host):
        node["IPv4"] = host
    derp_map = {"OmitDefaultRegions": True, "Regions": {str(DERP_REGION): {
        "RegionID": DERP_REGION, "RegionCode": "vps", "RegionName": socket.gethostname(), "Nodes": [node]}}}
    info["host"] = host
    info["acl"] = '"derpMap": ' + json.dumps(derp_map, indent=2) + ","
    return info


# --- apply everything -------------------------------------------------------

def apply_net(st, boot=False):
    """Make the system match state.json. Returns a list of warnings."""
    warns = []
    apply_firewall(st, warns)
    apply_exit_routing(st, warns)
    if st["exit_node"] and st["egress"] == "proxy" and st["proxy_dns"]:
        dns_to_mihomo()
    else:
        dns_restore()
    if not boot:  # at boot, tailscaled and docker keep their own saved state
        if st["exit_node"]:
            enable_forwarding()
        if not ok(["tailscale", "set", f"--advertise-exit-node={'true' if st['exit_node'] else 'false'}"]):
            warns.append("tailscale set --advertise-exit-node failed: is Tailscale logged in?")
        apply_cliproxyapi(st, warns)
    return warns


def change(fn):
    """Load state, let fn modify it, save and apply. Returns warnings."""
    with LOCK:
        st = load_state()
        fn(st)
        save_state(st)
        return apply_net(st)


def set_settings(body):
    def edit(st):
        if "egress" in body:
            if body["egress"] not in ("proxy", "direct"):
                raise Err("egress must be proxy or direct")
            st["egress"] = body["egress"]
        for key in FEATURES:
            if key in body:
                st[key] = bool(body[key])
    return change(edit)


def parse_port(spec):
    port, _, proto = str(spec).partition("/")
    proto = proto or "tcp"
    if not port.isdigit() or not 1 <= int(port) <= 65535 or proto not in ("tcp", "udp"):
        raise Err("port must be 1-65535, optionally /tcp or /udp")
    return int(port), proto


def set_port(spec, access, label=None):
    port, proto = parse_port(spec)
    if access not in ACCESS:
        raise Err("access must be tailscale, public or closed")
    if port == PANEL_PORT and proto == "tcp" and access == "closed":
        raise Err("closing the panel's own port would lock you out of it")

    def edit(st):
        for p in st["ports"]:
            if p["port"] == port and p["proto"] == proto:
                p["access"] = access
                if label is not None:
                    p["label"] = label[:40]
                return
        st["ports"].append({"port": port, "proto": proto, "access": access, "label": (label or "")[:40]})
        st["ports"].sort(key=lambda p: (p["port"], p["proto"]))
    return change(edit)


def remove_port(spec):
    port, proto = parse_port(spec)

    def edit(st):
        left = [p for p in st["ports"] if not (p["port"] == port and p["proto"] == proto)]
        if len(left) == len(st["ports"]):
            raise Err(f"no rule for {port}/{proto}")
        st["ports"] = left
    return change(edit)


# --- views ------------------------------------------------------------------

def listeners():
    """{(proto, port): {"process": name, "local_only": bool}} from ss."""
    res = {}
    for line in run(["ss", "-Hlntup"], check=False).splitlines():
        f = line.split()
        if len(f) < 5:
            continue
        addr, _, port = f[4].rpartition(":")
        if not port.isdigit():
            continue
        e = res.setdefault((f[0], int(port)), {"process": None, "local_only": True})
        m = re.search(r'users:\(\("([^"]+)"', line)
        if m and not e["process"]:
            e["process"] = m.group(1)
        host = addr.split("%")[0].strip("[]")
        if not (host.startswith("127.") or host == "::1"):
            e["local_only"] = False
    return res


def tailscale_ip():
    out = run(["tailscale", "ip", "-4"], check=False).split()
    return out[0] if out else None


def warnings_for(st, now, health, cpa):
    w = []
    if st["egress"] == "proxy" and now in (None, "REJECT"):
        users = [n for n, on in (("CLIProxyAPI", st["cliproxyapi"]), ("exit-node clients", st["exit_node"])) if on]
        w.append(f"No proxy selected, so {' and '.join(users) or 'proxied traffic'} can't reach the internet. "
                 "Add a proxy, or switch egress to direct.")
    if st["egress"] == "proxy" and health["mihomo"] != "active":
        w.append("mihomo is not running, so proxied traffic is blocked: systemctl status mihomo")
    if st["exit_node"] and not health["forwarding"]:
        w.append("IP forwarding is off, so exit-node clients can't load anything.")
    if not st["firewall"]:
        w.append(f"Firewall rules are off: this panel (port {PANEL_PORT}) is reachable from the internet.")
    if st["cliproxyapi"] and cpa["installed"] and cpa["proxy_url"] != cpa_wanted_url(st):
        w.append("CLIProxyAPI's proxy-url doesn't match the egress setting.")
    if st["egress"] == "proxy" and st["exit_node"] and not st["kill_switch"]:
        w.append("Kill switch is off: if the proxy goes down, exit-node traffic leaves via the VPS's own IP.")
    return w


def overview():
    st = load_state()
    now = selected()
    lst = listeners()
    rule = run(["ip", "rule", "show", "priority", "100"], check=False)
    route = run(["ip", "route", "show", "table", "100"], check=False)
    health = {
        "mihomo": run(["systemctl", "is-active", "mihomo"], check=False).strip() or "unknown",
        "forwarding": fwd_on(),
        "exit_rule": "lookup 100" in rule,
        "tun_route": "dev tun0" in route,
        "dns_via_mihomo": dns_via_mihomo(),
    }
    cpa_text = ""
    if os.path.exists(CPA_CONF):
        with open(CPA_CONF) as f:
            cpa_text = f.read()
    ts_ip = tailscale_ip()
    cpa = {
        "installed": bool(cpa_text),
        "container": cpa_container() if cpa_text else None,
        "proxy_url": cpa_get_proxy_url(cpa_text) if cpa_text else None,
        "endpoint": f"http://{ts_ip or '<tailscale-ip>'}:{CPA_PORT}/v1",
        "management": f"http://{ts_ip or '<tailscale-ip>'}:{CPA_PORT}/management.html",
        "keys": st["cliproxyapi_keys"],
    }
    ports = []
    for p in st["ports"]:
        listener = lst.get((p["proto"], p["port"]))
        ports.append(p | {"listening": bool(listener),
                          "process": listener and listener["process"],
                          "local_only": bool(listener and listener["local_only"])})
    return {
        "host": socket.gethostname(),
        "tailscale_ip": ts_ip,
        "wan": wan_if(),
        "egress": st["egress"],
        "features": {k: st[k] for k in FEATURES},
        "selected": now,
        "proxies": [{k: p[k] for k in ("name", "type", "server", "port")} | {"auth": "username" in p}
                    for p in st["proxies"]],
        "latency": LAST_TEST,
        "speed": LAST_SPEED,
        "ports": ports,
        "health": health,
        "cliproxyapi": cpa,
        "derp": derp_info(),
        "warnings": warnings_for(st, now, health, cpa),
        "panel_port": PANEL_PORT,
        "at": int(time.time()),
    }


# --- web panel --------------------------------------------------------------

def route(method, path, body):
    if (method, path) == ("GET", "state"):
        return overview()
    if (method, path) == ("GET", "exit"):
        return exit_ips()
    if (method, path) == ("GET", "test"):
        return test_all()
    if (method, path) == ("POST", "speedtest"):
        return speed_test(str(body.get("name", "")))
    if (method, path) == ("POST", "proxies"):
        add_proxy(str(body.get("name", "")), str(body.get("proxy", "")))
    elif method == "DELETE" and path.startswith("proxies/"):
        remove_proxy(urllib.parse.unquote(path[len("proxies/"):]))
    elif (method, path) == ("PUT", "select"):
        use_proxy(str(body.get("name", "")))
    elif (method, path) == ("POST", "settings"):
        warns = set_settings(body)
        return overview() | {"applied": warns}
    elif (method, path) == ("POST", "ports"):
        label = body.get("label")
        warns = set_port(f"{body.get('port')}/{body.get('proto', 'tcp')}", str(body.get("access", "")),
                         None if label is None else str(label))
        return overview() | {"applied": warns}
    elif method == "DELETE" and path.startswith("ports/"):
        warns = remove_port(urllib.parse.unquote(path[len("ports/"):]))
        return overview() | {"applied": warns}
    elif (method, path) == ("POST", "apply"):
        with LOCK:
            warns = apply_net(load_state())
        return overview() | {"applied": warns}
    elif (method, path) == ("POST", "forwarding"):
        enable_forwarding()
    else:
        raise Err("unknown endpoint")
    return overview()


def panel_page():
    for path in PANEL_HTML:
        if os.path.exists(path):
            with open(path, "rb") as f:
                return f.read()
    return b"panel.html not found: re-run setup.sh"


class Panel(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def reply(self, code, obj=None, raw=None, ctype="application/json"):
        body = raw if raw is not None else json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def handle_any(self, method):
        path = urllib.parse.urlsplit(self.path).path
        if method == "GET" and path in ("/", "/index.html"):
            return self.reply(200, raw=panel_page(), ctype="text/html; charset=utf-8")
        if not path.startswith("/api/"):
            return self.reply(404, {"error": "not found"})
        secret = load_state()["secret"]
        given = self.headers.get("Authorization", "").encode()
        if not secret or not secrets.compare_digest(given, f"Bearer {secret}".encode()):
            return self.reply(401, {"error": "wrong secret"})
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(n)) if n else {}
            self.reply(200, route(method, path[len("/api/"):], body))
        except Err as e:
            self.reply(400, {"error": str(e)})
        except Exception as e:
            self.reply(500, {"error": f"{type(e).__name__}: {e}"})

    def do_GET(self):
        self.handle_any("GET")

    def do_POST(self):
        self.handle_any("POST")

    def do_PUT(self):
        self.handle_any("PUT")

    def do_DELETE(self):
        self.handle_any("DELETE")


# --- CLI --------------------------------------------------------------------

def onoff(value):
    if value not in ("on", "off"):
        raise Err("expected on or off")
    return value == "on"


def print_warnings(warns):
    for w in warns:
        print(f"warning: {w}")


def cli(args):
    cmd = args[0] if args else "status"
    if cmd == "status":
        o = overview()
        ips = exit_ips()
        f = o["features"]
        e = ips["proxy"] if o["egress"] == "proxy" else ips["direct"]
        print(f"egress:      {o['egress']}" + (f" via {o['selected'] or '?'}" if o["egress"] == "proxy" else f" via {o['wan']}"))
        print(f"exit IP:     {e['ip']}  {e.get('city')}, {e.get('country')}  {e.get('org')}" if e else "exit IP:     unreachable")
        print(f"exit node:   {'on' if f['exit_node'] else 'off'}" + (f" (kill switch {'on' if f['kill_switch'] else 'OFF'})" if f["exit_node"] and o["egress"] == "proxy" else ""))
        print(f"forwarding:  {'on' if o['health']['forwarding'] else 'off'}")
        print(f"mihomo:      {o['health']['mihomo']}")
        c = o["cliproxyapi"]
        print(f"CLIProxyAPI: " + ("not installed" if not c["installed"] else f"{c['container'] or 'no container'}, proxy-url {c['proxy_url'] or '(direct)'}"))
        print(f"firewall:    {'on' if f['firewall'] else 'OFF'}, {sum(p['access'] != 'public' for p in o['ports'])} restricted ports")
        print_warnings(o["warnings"])
    elif cmd == "list":
        now, proxies = selected(), load_state()["proxies"]
        if not proxies:
            print("no proxies yet: proxyctl add NAME socks5://user:pass@host:port")
        for p in proxies:
            print(f"{'*' if p['name'] == now else ' '} {p['name']:<20} {p['type']} {p['server']}:{p['port']}")
        if now == "REJECT":
            print("* REJECT (everything blocked)")
    elif cmd == "add" and len(args) == 3:
        add_proxy(args[1], args[2])
        print(f"added {args[1]}, selected: {selected()}")
    elif cmd == "remove" and len(args) == 2:
        remove_proxy(args[1])
        print(f"removed {args[1]}, selected: {selected()}")
    elif cmd == "use" and len(args) == 2:
        use_proxy(args[1])
        print(f"switched to {args[1]}")
    elif cmd == "test":
        for name, r in test_all().items():
            result = f"{r['ms']} ms" if r["ms"] else f"failed: {r['error']}"
            print(f"{name:<20} {result}")
    elif cmd == "speed" and len(args) <= 2:
        names = args[1:] or [p["name"] for p in load_state()["proxies"]] + ["DIRECT"]
        for name in names:
            r = speed_test(name)
            result = (f"down {r['down_mbps']} Mbps, up {r.get('up_mbps') or '?'} Mbps, first byte {r['ttfb_ms']} ms"
                      if "down_mbps" in r else "")
            if r.get("error"):
                result += ("  " if result else "") + f"failed: {r['error']}"
            print(f"{name:<20} {result}")
    elif cmd == "egress" and len(args) == 2:
        print_warnings(set_settings({"egress": args[1]}))
        print(f"egress: {args[1]}")
    elif cmd in ("exit-node", "routing") and len(args) == 2:
        print_warnings(set_settings({"exit_node": onoff(args[1])}))
        print(f"exit node: {args[1]}")
        if args[1] == "on":
            print("first time? Tailscale admin console -> Machines -> this VPS -> Edit route settings -> Use as exit node")
    elif cmd == "set" and len(args) == 3:
        key = args[1].replace("-", "_")
        if key not in FEATURES:
            raise Err(f"unknown feature, choose from: {', '.join(k.replace('_', '-') for k in FEATURES)}")
        print_warnings(set_settings({key: onoff(args[2])}))
        print(f"{args[1]}: {args[2]}")
    elif cmd == "ports":
        for p in overview()["ports"]:
            who = (p["process"] or "listening") + (" (localhost only)" if p["local_only"] else "") if p["listening"] else "-"
            print(f"{p['port']:>5}/{p['proto']:<4} {p['access']:<10} {p['label']:<28} {who}")
    elif cmd == "port" and len(args) == 3 and args[1] == "remove":
        print_warnings(remove_port(args[2]))
    elif cmd == "port" and len(args) >= 3:
        print_warnings(set_port(args[1], args[2], " ".join(args[3:]) or None))
        print(f"{args[1]}: {args[2]}")
    elif cmd == "forwarding":
        for key, val in fwd_values().items():
            print(f"{key} = {val}")
        if fwd_on():
            print("forwarding is on")
        else:
            enable_forwarding()
            print(f"forwarding enabled (saved in {SYSCTL_FILE})")
    elif cmd == "derp":
        d = derp_info()
        if not d["installed"]:
            print("DERP relay not installed: sudo bash setup.sh --derp")
        else:
            print(f"derper: {d['service']}, https://{d['host'] or '?'}:{DERP_PORT}")
            if d["acl"]:
                print("\nPaste this into the Tailscale admin console -> Access controls, inside the top-level { }:\n")
                print(d["acl"])
            else:
                print(f"no certificate in {DERP_DIR} yet: journalctl -u derper -n 30")
    elif cmd == "secret":
        print(load_state()["secret"] or "no secret yet: proxyctl init")
    elif cmd == "init":
        init()
    elif cmd == "init-cliproxyapi":
        init_cliproxyapi()
    elif cmd == "apply":
        with LOCK:
            print_warnings(apply_net(load_state(), boot="--boot" in args))
    elif cmd == "serve":
        ThreadingHTTPServer(("0.0.0.0", PANEL_PORT), Panel).serve_forever()
    else:
        print(__doc__.strip())
        return 1
    return 0


if __name__ == "__main__":
    if os.geteuid() != 0:
        sys.exit("run as root: sudo proxyctl " + " ".join(sys.argv[1:]))
    try:
        sys.exit(cli(sys.argv[1:]))
    except Err as e:
        sys.exit(f"error: {e}")
    except urllib.error.URLError as e:
        sys.exit(f"error: mihomo API unreachable ({e.reason}): systemctl status mihomo")

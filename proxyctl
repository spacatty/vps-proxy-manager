#!/usr/bin/env python3
"""proxyctl - control panel + CLI for this VPS: proxies, egress, exit node, CLIProxyAPI, firewall. Run as root.

  proxyctl status                      egress, exit IP, services, warnings
  proxyctl list                        proxies (* = active)
  proxyctl add NAME PROXY              PROXY: socks5://user:pass@host:port, http://..., or host:port:user:pass
  proxyctl remove NAME                 delete a proxy
  proxyctl use NAME                    switch the active proxy (REJECT = block everything)
  proxyctl test                        latency of every proxy
  proxyctl speed [NAME|direct]         download/upload speed of one proxy, or of every proxy and the VPS itself
  proxyctl egress proxy|direct         send traffic through the selected proxy, or straight out of the VPS
  proxyctl exit-node on|off            advertise this VPS as a Tailscale exit node
  proxyctl set FEATURE on|off          FEATURE: kill-switch, proxy-dns, cliproxyapi, firewall
  proxyctl ports                       firewall port rules and what listens on each port
  proxyctl port PORT[/udp] tailscale|public|closed [LABEL]
  proxyctl port remove PORT[/udp]
  proxyctl forwarding                  check IP forwarding, enable it (persistently) if off
  proxyctl derp                        DERP relay status and the derpMap to paste into the tailnet policy
  proxyctl secret                      print the panel secret
  proxyctl init | init-cliproxyapi | apply [--boot] | serve     used by setup.sh and the systemd units
"""
